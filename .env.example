# Configuración pública de Ganamos (sin secretos ni credenciales)
# Estas propiedades pueden definirse como Gradle properties (-PGANAMOS_API_URL=...)
# o variables de entorno al compilar el proyecto.
#
# GANAMOS_PLATFORM_URL=https://ganamos.net
# GANAMOS_API_URL=https://api.ganamos.net
# GANAMOS_CHAT_ENABLED=true
# GANAMOS_EMBED_ALLOWED=false
# GANAMOS_PUBLIC_BANK_CBU=
# GANAMOS_PUBLIC_BANK_ALIAS=
# GANAMOS_PUBLIC_BANK_HOLDER=
# GANAMOS_MIN_DEPOSIT_LABEL=
# GANAMOS_JURISDICTION_NOTICE=Servicio disponible únicamente para mayores de 18 años.
