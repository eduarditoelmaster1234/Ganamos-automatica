# Configuración pública de Ganamos (PWA)
# Copiá este archivo como .env y completá los valores reales del operador.
# No incluyas secretos privados: estas variables quedan visibles en el cliente.

# URL base del backend (sin barra final). Si no responde, el registro
# usa el fallback local automáticamente.
VITE_API_URL=http://localhost:3000

# Datos públicos de transferencia. Dejalos vacíos si el operador todavía
# no los configuró: la app muestra el estado pendiente y no inventa datos.
VITE_PUBLIC_BANK_CBU=
VITE_PUBLIC_BANK_ALIAS=
VITE_PUBLIC_BANK_HOLDER=
VITE_MIN_DEPOSIT_LABEL=

# Para previsualizar la tarjeta de transferencia en desarrollo podés usar
# datos claramente marcados como demo (nunca en producción):
# VITE_PUBLIC_BANK_CBU=0000003100010000000001
# VITE_PUBLIC_BANK_ALIAS=GANAMOS.DEMO
# VITE_PUBLIC_BANK_HOLDER=GANAMOS DEMO S.A.
# VITE_MIN_DEPOSIT_LABEL=$1.000

# Aviso legal de edad/jurisdicción.
VITE_JURISDICTION_NOTICE=Servicio disponible únicamente para mayores de 18 años.
