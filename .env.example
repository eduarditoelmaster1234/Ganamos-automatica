# Configuración pública de Ganamos (PWA)
# Copiá este archivo como .env y completá los valores reales del operador.
# No incluyas secretos privados: estas variables quedan visibles en el cliente.

# URL base del backend (sin barra final). El registro y el saldo dependen de
# que este backend esté corriendo; si no responde, se muestra un error claro
# y se permite reintentar (ya no existe una cuenta local de resguardo).
VITE_API_URL=http://localhost:3000

# Datos públicos de transferencia mostrados en la tarjeta de CARGAR.
# Si se dejan vacíos, se usan los defaults publicados por el operador en
# src/config/appConfig.ts. Sobreescribilos acá solo si cambian.
VITE_PUBLIC_BANK_CBU=0000151500035454008162
VITE_PUBLIC_BANK_ALIAS=ANSIA.BUENO.BALCON
VITE_PUBLIC_BANK_HOLDER=ESHTECH SRL
VITE_MIN_DEPOSIT_LABEL=$3.000

# Aviso legal de edad/jurisdicción.
VITE_JURISDICTION_NOTICE=Servicio disponible únicamente para mayores de 18 años.

# Notas de comportamiento:
# - La contraseña del jugador la emite el backend (PLAYER_PASSWORD, default 12345a).
# - El retiro mínimo es $10.000 y se configura en appConfig.withdrawals.
# - Los datos bancarios se editan en src/config/appConfig.ts, nunca dentro del chat.
# - Las credenciales del agente del panel viven SOLO en server/.env, nunca acá.
