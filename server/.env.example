# Backend de Ganamos · configuración del servidor
# Copiá este archivo como .env y completá AGENT_USER / AGENT_PASS.
# NUNCA expongas estas variables en el frontend ni las subas al repositorio.

PORT=3000
HOST=0.0.0.0

# Panel real de agentes. El adaptador usa same-origin + cookies de sesión.
AGENT_BASE_URL=https://agents.ganamos.net
AGENT_USER=
AGENT_PASS=

# SQLite persistente. Ruta relativa a server/ o absoluta.
# También acepta file:./data/ganamos.db o :memory: (solo pruebas).
DATABASE_URL=./data/ganamos.db

# Orígenes exactos autorizados para CORS (separados por coma, sin barra final).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Segundos que se reutiliza la sesión del agente antes de renovarla.
AGENT_SESSION_TTL=1200
# Timeout de cada llamada al panel, en milisegundos.
AGENT_TIMEOUT_MS=12000

# Contraseña emitida a los jugadores en este flujo.
PLAYER_PASSWORD=12345a

LOG_LEVEL=info
TRUST_PROXY=false
